{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python ECommerce/vercel_build.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "ECommerce/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
